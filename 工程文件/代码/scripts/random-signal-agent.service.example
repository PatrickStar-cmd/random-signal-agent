[Unit]
Description=Random Signal Agent
After=network.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/path/to/random-signal-agent
EnvironmentFile=/path/to/random-signal-agent/config/server.env
ExecStart=/path/to/random-signal-agent/.venv/bin/python -u /path/to/random-signal-agent/server.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
