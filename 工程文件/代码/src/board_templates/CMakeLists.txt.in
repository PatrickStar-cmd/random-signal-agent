cmake_minimum_required(VERSION 3.13)
set(PICO_BOARD @BOARD@ CACHE STRING "Target Raspberry Pi Pico board")
if(NOT PICO_SDK_PATH)
    set(PICO_SDK_PATH "$ENV{PICO_SDK_PATH}")
endif()
include("${PICO_SDK_PATH}/external/pico_sdk_import.cmake")
project(randomsign_board C CXX ASM)
set(CMAKE_CXX_STANDARD 17)
pico_sdk_init()

add_executable(randomsign_board main.cpp)
target_link_libraries(randomsign_board PRIVATE pico_stdlib hardware_uart)
pico_enable_stdio_usb(randomsign_board 1)
pico_enable_stdio_uart(randomsign_board 0)
pico_add_extra_outputs(randomsign_board)
