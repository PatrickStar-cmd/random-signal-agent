# Random Signal Agent server configuration template.
# Copy this file to config/server.env, then fill in your own values.

RS_AGENT_HOST=0.0.0.0
RS_AGENT_PORT=8000
RS_AGENT_DATA_DIR=data

# OpenAI-compatible LLM endpoint.
# Fill in your provider's API base URL, model name and API key here.
# Leave these values empty to use the local rule-based fallback.
RS_AGENT_LLM_BASE_URL=
RS_AGENT_LLM_MODEL=
RS_AGENT_LLM_API_KEY=
RS_AGENT_LLM_TIMEOUT=45

# Startup scripts overwrite this log on each run.
RS_AGENT_LOG_FILE=logs/server/server.log
